<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/MariaDb/bootstrap.php"
         colors="true"
         cacheResult="false">
    <testsuites>
        <testsuite name="MariaDB">
            <file>tests/MariaDb/IntegrityTest.php</file>
        </testsuite>
        <testsuite name="MariaDBConcurrency">
            <directory>tests/MariaDb/Concurrency</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="gift_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MARIADB_INTEGRATION" value="1" force="true"/>
        <env name="MARIADB_ALLOW_WRITES" value="0"/>
        <env name="MARIADB_ALLOW_CONCURRENCY" value="0"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
    </php>
</phpunit>
